# Puerto y bind del servidor HTTP
HOST=0.0.0.0
PORT=3000

# Archivo SQLite. En Docker apunta al volumen: /data/jira-tracker.sqlite
DATABASE_PATH=./data/jira-tracker.sqlite

# Fuente de /data al usar Docker Compose. En local permite usar la misma BD que pnpm start.
DATABASE_VOLUME=./data

# Secreto compartido con Jira. Se manda en el header X-Webhook-Secret.
# Generar con: openssl rand -hex 32
JIRA_WEBHOOK_SECRET=

# URL pública de tu instancia Jira. El dashboard abre cada issue en esta instancia.
# Ejemplo: https://tu-equipo.atlassian.net
VITE_JIRA_BASE_URL=

# Loguea el body crudo de cada webhook que llega. Sirve para verificar en prod
# que Jira manda lo que esperamos. Poner en false una vez validado.
LOG_WEBHOOK_BODY=true

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
